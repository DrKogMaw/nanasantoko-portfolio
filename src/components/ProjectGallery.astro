---
import ProjectImage from './ProjectImage.astro';

interface Props {
  slides: { src: string; alt: string; caption: string }[];
  label: string;
}

const { slides, label } = Astro.props;
---

<section class="gallery" aria-label={label} data-gallery>
  {slides.map((slide, index) => (
    <figure hidden={index !== 0} data-slide>
      <a class="gallery-image" href={slide.src} target="_blank" rel="noopener" aria-label={`Open full-size screenshot in a new tab: ${slide.alt}`}>
        <ProjectImage src={slide.src} alt={slide.alt} sizes="(max-width: 800px) 94vw, (max-width: 1260px) 56vw, 680px" priority={index === 0} />
      </a>
      <figcaption>
        <span>{slide.caption}</span>
        <a href={slide.src} target="_blank" rel="noopener" aria-label={`Open ${slide.caption} full size in a new tab`}>Full size ↗</a>
      </figcaption>
    </figure>
  ))}
  <div class="gallery-controls">
    <button type="button" data-prev aria-label="Previous screenshot">←</button>
    <span aria-live="polite" data-count>1 of {slides.length}</span>
    <div class="gallery-dots" role="group" aria-label="Choose screenshot">
      {slides.map((slide, index) => (
        <button type="button" data-dot aria-label={`Show ${slide.caption}`} aria-current={index === 0 ? 'true' : undefined}></button>
      ))}
    </div>
    <button type="button" data-next aria-label="Next screenshot">→</button>
  </div>
</section>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const slides = Array.from(gallery.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const count = gallery.querySelector<HTMLElement>('[data-count]')!;
    let current = 0;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, position) => { slide.hidden = position !== current; });
      dots.forEach((dot, position) => {
        if (position === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      count.textContent = `${current + 1} of ${slides.length}`;
    }

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
  }
</script>

<style>
  .gallery { min-width: 0; }
  figure { margin: 0; }
  .gallery-image {
    display: grid;
    align-items: center;
    aspect-ratio: 1.7;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--soft);
    cursor: zoom-in;
  }
  .gallery-image :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  figcaption, .gallery-controls { display: flex; align-items: center; gap: 10px; }
  figcaption { justify-content: space-between; padding: 4px 0; color: var(--muted); font-size: .84rem; }
  figcaption a { flex: none; padding: 10px 0; color: var(--primary); font-weight: 700; text-underline-offset: 3px; }
  .gallery-controls { border-top: 1px solid var(--line); padding-top: 8px; }
  .gallery-controls button { color: var(--primary); cursor: pointer; }
  .gallery-controls > button {
    background: var(--panel); border: 1px solid var(--line); border-radius: 50%;
    width: 44px; height: 44px; font-size: 1.2rem;
  }
  .gallery-controls > button:hover { background: var(--chip); }
  [data-count] { color: var(--muted); font-size: .83rem; font-variant-numeric: tabular-nums; }
  .gallery-dots { display: flex; margin-left: auto; }
  .gallery-dots button { display: grid; place-items: center; width: 28px; height: 44px; padding: 0; background: transparent; border: 0; }
  .gallery-dots button::before { content: ''; width: 8px; height: 8px; border-radius: 8px; background: var(--muted); }
  .gallery-dots button[aria-current]::before { width: 20px; background: var(--primary); }
  @media (max-width: 400px) {
    .gallery-controls { gap: 4px; }
    .gallery-dots button { width: 24px; }
  }
</style>
