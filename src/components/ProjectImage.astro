---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  priority?: boolean;
}

const { src, alt, sizes, priority = false } = Astro.props;
const images = import.meta.glob<ImageMetadata>('/public/projects/**/*.{jpg,png}', {
  eager: true,
  import: 'default',
});
const image = images[`/public${src}`];
if (!image) throw new Error(`Missing project screenshot: ${src}`);
---

<Image
  src={image}
  alt={alt}
  widths={[400, 720, 1080]}
  sizes={sizes}
  format="webp"
  quality={85}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
/>
