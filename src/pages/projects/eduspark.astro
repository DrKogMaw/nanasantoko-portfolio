---
import '../../styles/global.css';
import '../../styles/project.css';
import ProjectGallery from '../../components/ProjectGallery.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';

const pageUrl = 'https://nanasantoko.dev/projects/eduspark/';
const repositoryUrl = 'https://github.com/DrKogMaw/eduspark';
const description = 'Explore EduSpark, a local-first reading, spelling, and vocabulary practice prototype for children ages 6–10.';
const year = new Date().getFullYear();
const slides = [
  { src: '/projects/eduspark/dashboard.jpg', alt: 'EduSpark dashboard showing YonRead, TypoSnap, GuessingSnap, and the planned PhonicLab activity.', caption: 'Learning dashboard' },
  { src: '/projects/eduspark/yonread.jpg', alt: 'YonRead reading screen showing one focused word, story selection, reading progress, and speed controls.', caption: 'YonRead · reading fluency' },
  { src: '/projects/eduspark/typosnap.jpg', alt: 'TypoSnap spelling game showing an illustrated word with a missing letter and four choices.', caption: 'TypoSnap · spelling practice' },
  { src: '/projects/eduspark/guessingsnap.jpg', alt: 'GuessingSnap vocabulary game showing an illustration and four word choices with audio prompts.', caption: 'GuessingSnap · word recognition' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f9f7ff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Nanasantoko" />
    <meta property="og:title" content="EduSpark — Nanasantoko" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://nanasantoko.dev/projects/eduspark/dashboard.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>EduSpark — Nanasantoko</title>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
  </head>
  <body id="top">
    <div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href="/" aria-label="Nanasantoko, home"><span class="brand-mark" aria-hidden="true">✦</span>Nanasantoko<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#about">About</a><a href="/#contact">Contact</a></nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span></button>
    </div></header>

    <main class="detail-main section-width">
      <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="/#work">Selected work</a><span aria-hidden="true">/</span><span aria-current="page">EduSpark</span></nav>
      <div class="project-intro">
        <section class="detail-hero" aria-labelledby="detail-title">
          <h1 id="detail-title">EduSpark<span>.</span></h1>
          <p class="project-type">Learning prototype · Local first</p>
          <p>A playful place to practice reading, spelling, and vocabulary. Children can read one word at a time, complete illustrated words, and match pictures with spoken prompts.</p>
          <div class="detail-actions"><a class="button button-primary" href={repositoryUrl} target="_blank" rel="noopener noreferrer"><GitHubIcon /> View repository <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/#work">Back to all projects</a></div>
        </section>

        <ProjectGallery slides={slides} label="EduSpark screenshots" />
      </div>

      <section class="detail-overview" aria-labelledby="overview-title"><div><h2 id="overview-title">Short activities for growing readers.</h2><p>EduSpark is a browser-based prototype for children ages 6–10. YonRead supports reading fluency, TypoSnap practices spelling, and GuessingSnap builds vocabulary. It offers English and Georgian interface modes, while learning progress and parent-added content stay in the browser. PhonicLab is shown as a planned activity.</p></div><ul aria-label="EduSpark features"><li>One-word-at-a-time reading practice</li><li>Illustrated spelling and word matching</li><li>English and Georgian interface modes</li><li>Local progress and parent-added content</li></ul></section>
    </main>
    <footer class="site-footer section-width"><span>© {year} Nanasantoko</span><a href="#top">Back to top ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const syncTheme = () => { const dark = document.documentElement.dataset.theme === 'dark'; if (toggle) { toggle.setAttribute('aria-pressed', String(dark)); toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); } };
      syncTheme();
      toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme', next); } catch {} syncTheme(); });
    </script>
  </body>
</html>
