---
import '../../styles/global.css';
import '../../styles/project.css';
import ProjectGallery from '../../components/ProjectGallery.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';

const pageUrl = 'https://nanasantoko.dev/projects/deskdrawer-inventory/';
const repositoryUrl = 'https://github.com/DrKogMaw/desk-drawer-inventory';
const description = 'A closer look at DeskDrawer Inventory, a local-first Windows app for organizing desk drawers, attachments, stock levels, and JSON backups.';
const year = new Date().getFullYear();
const slides = [
  { src: '/projects/deskdrawer-inventory/dark-overview.png', alt: 'DeskDrawer Inventory in dark mode, showing the drawer list, stock summary, and empty drawer view.', caption: 'Drawer overview · dark theme' },
  { src: '/projects/deskdrawer-inventory/dark-item-form.png', alt: 'DeskDrawer Inventory dark theme item form with fields for a USB-C cable, quantity, notes, and attachments.', caption: 'Add an item · dark theme' },
  { src: '/projects/deskdrawer-inventory/light-overview.png', alt: 'DeskDrawer Inventory in light mode, showing the drawer list, stock summary, and empty drawer view.', caption: 'Drawer overview · light theme' },
  { src: '/projects/deskdrawer-inventory/light-item-form.png', alt: 'DeskDrawer Inventory light theme item form with fields for drawer, category, quantity, notes, and attachments.', caption: 'Add an item · light theme' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f9f7ff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Nanasantoko" />
    <meta property="og:title" content="DeskDrawer Inventory — Nanasantoko" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://nanasantoko.dev/projects/deskdrawer-inventory/dark-overview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>DeskDrawer Inventory — Nanasantoko</title>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
  </head>
  <body id="top">
    <div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href="/" aria-label="Nanasantoko, home"><span class="brand-mark" aria-hidden="true">✦</span>Nanasantoko<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#about">About</a><a href="/#contact">Contact</a></nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span></button>
    </div></header>

    <main class="detail-main section-width">
      <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="/#work">Selected work</a><span aria-hidden="true">/</span><span aria-current="page">DeskDrawer Inventory</span></nav>
      <div class="project-intro">
        <section class="detail-hero" aria-labelledby="detail-title">
          <h1 id="detail-title">DeskDrawer <span>Inventory.</span></h1>
          <p class="project-type">Windows desktop app · Local first</p>
          <p>Keep track of what is in each desk drawer. DeskDrawer combines searchable items, stock alerts, file attachments, and portable JSON backups in one local inventory.</p>
          <div class="detail-actions"><a class="button button-primary" href={repositoryUrl} target="_blank" rel="noopener noreferrer"><GitHubIcon /> View repository <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/#work">Back to all projects</a></div>
        </section>

        <ProjectGallery slides={slides} label="DeskDrawer Inventory screenshots" />
      </div>

      <section class="detail-overview" aria-labelledby="overview-title"><div><h2 id="overview-title">An inventory that stays close to your work.</h2><p>DeskDrawer groups items by drawer and makes them easy to search. Quantity and low-stock indicators help you notice what needs replenishing. Items can include photos or documents, and the inventory can be exported or restored as a JSON backup.</p></div><ul aria-label="DeskDrawer features"><li>Drawer-based organization</li><li>Search and low-stock alerts</li><li>Photo and document attachments</li><li>Portable JSON import and export</li></ul></section>
    </main>
    <footer class="site-footer section-width"><span>© {year} Nanasantoko</span><a href="#top">Back to top ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const syncTheme = () => { const dark = document.documentElement.dataset.theme === 'dark'; if (toggle) { toggle.setAttribute('aria-pressed', String(dark)); toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); } };
      syncTheme();
      toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme', next); } catch {} syncTheme(); });
    </script>
  </body>
</html>
