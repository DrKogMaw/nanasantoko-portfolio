---
import '../../styles/global.css';
import '../../styles/project.css';
import ProjectGallery from '../../components/ProjectGallery.astro';
import GitHubIcon from '../../components/GitHubIcon.astro';

const pageUrl = 'https://nanasantoko.dev/projects/credit-compass-georgia/';
const repositoryUrl = 'https://github.com/DrKogMaw/credit-compass-georgia';
const description = 'Explore Credit Compass Georgia, a planning tool that estimates university course matches, transferable ECTS, and study workload. Results are not official credit decisions.';
const year = new Date().getFullYear();
const slides = [
  { src: '/projects/credit-compass-georgia/overview.png', alt: 'Credit Compass Georgia demo overview showing destination selection, a mobility estimate, ECTS workload, and university comparisons.', caption: 'Mobility overview · demo profile' },
  { src: '/projects/credit-compass-georgia/course-matches.png', alt: 'Credit Compass Georgia listing course-by-course matches with similarity percentages and expandable details.', caption: 'Course matches · demo profile' },
  { src: '/projects/credit-compass-georgia/transcript.png', alt: 'Credit Compass Georgia transcript panel showing passed and failed demo courses, grouped by semester.', caption: 'Transcript editor · demo profile' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f9f7ff" />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Nanasantoko" />
    <meta property="og:title" content="Credit Compass Georgia — Nanasantoko" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://nanasantoko.dev/projects/credit-compass-georgia/overview.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>Credit Compass Georgia — Nanasantoko</title>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
  </head>
  <body id="top">
    <div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header"><div class="nav-shell">
      <a class="brand" href="/" aria-label="Nanasantoko, home"><span class="brand-mark" aria-hidden="true">✦</span>Nanasantoko<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="/#work">Work</a><a href="/#about">About</a><a href="/#contact">Contact</a></nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span></button>
    </div></header>

    <main class="detail-main section-width">
      <nav class="detail-breadcrumb" aria-label="Breadcrumb"><a href="/#work">Selected work</a><span aria-hidden="true">/</span><span aria-current="page">Credit Compass Georgia</span></nav>
      <div class="project-intro">
        <section class="detail-hero" aria-labelledby="detail-title">
          <h1 id="detail-title">Credit Compass <span>Georgia.</span></h1>
          <p class="project-type">University mobility · Planning tool</p>
          <p>See how completed courses might map to a destination curriculum. Compare possible credit recognition, review each match, and check study workload. The estimates support planning; the receiving university makes the official decision.</p>
          <div class="detail-actions"><a class="button button-primary" href={repositoryUrl} target="_blank" rel="noopener noreferrer"><GitHubIcon /> View repository <span aria-hidden="true">↗</span></a><a class="button button-quiet" href="/#work">Back to all projects</a></div>
        </section>

        <ProjectGallery slides={slides} label="Credit Compass Georgia screenshots" />
      </div>

      <section class="detail-overview" aria-labelledby="overview-title"><div><h2 id="overview-title">Make a study move easier to understand.</h2><p>Credit Compass Georgia compares a student transcript with destination courses and explains likely matches, transferable credit, and workload. The current source-backed curriculum dataset covers TSU Computer Science and GTU Computer Information Technologies; other visible programmes remain exploratory until their official curricula are imported.</p></div><ul aria-label="Credit Compass Georgia features"><li>Editable transcript and course results</li><li>Destination programme comparisons</li><li>Explained course-by-course matches</li><li>ECTS workload checks</li></ul></section>
    </main>
    <footer class="site-footer section-width"><span>© {year} Nanasantoko</span><a href="#top">Back to top ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const syncTheme = () => { const dark = document.documentElement.dataset.theme === 'dark'; if (toggle) { toggle.setAttribute('aria-pressed', String(dark)); toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); } };
      syncTheme();
      toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme', next); } catch {} syncTheme(); });
    </script>
  </body>
</html>
