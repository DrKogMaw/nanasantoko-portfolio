---
import '../styles/global.css';

const githubUrl = 'https://github.com/DrKogMaw';
const year = new Date().getFullYear();
const projects = [
  {
    name: 'DeskDrawer Inventory',
    category: 'Desktop app',
    description: 'A local inventory for the things in your desk drawers, with file attachments, photo previews, and portable JSON backups.',
    tags: ['TypeScript', 'Local storage'],
    url: 'https://github.com/DrKogMaw/desk-drawer-inventory',
  },
  {
    name: 'ZiAr',
    category: 'Windows + Android',
    description: 'File transfers between a Windows PC and Android phone, or between two phones, over local Wi-Fi with a pairing code.',
    tags: ['Kotlin', 'Local network'],
    url: 'https://github.com/DrKogMaw/ZiAr',
  },
  {
    name: 'Ewear',
    category: 'Storefront',
    description: 'A clothing storefront with category filters, a persistent shopping bag, phone-based sign-in, and tools for staff to manage products.',
    tags: ['Angular', 'ASP.NET Core'],
    url: 'https://github.com/DrKogMaw/ewear',
  },
  {
    name: 'EduSpark',
    category: 'Learning prototype',
    description: 'A local-first reading, spelling, and vocabulary practice app for children ages 6–10, with English and Georgian modes.',
    tags: ['JavaScript', 'Education'],
    url: 'https://github.com/DrKogMaw/eduspark',
  },
  {
    name: 'Credit Compass Georgia',
    category: 'Static MVP',
    description: 'An estimator for how completed university courses may map to Georgian curricula. Results are estimates, not official credit decisions.',
    tags: ['Curriculum data', 'Planning'],
    url: 'https://github.com/DrKogMaw/credit-compass-georgia',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f0e6" />
    <meta name="description" content="Nanasantoko's developer portfolio. Explore desktop tools, learning apps, and web projects." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nanasantoko — Developer</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="Nanasantoko, back to top">Nanasantoko<span class="wordmark-dot">.</span></a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-content">
            <p class="intro">Hello, I'm Nanasantoko.</p>
            <h1 id="hero-title">I make things<br /><em>for the web.</em></h1>
            <p class="hero-description">I build practical tools and digital experiences, from desktop utilities to learning apps.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-mark" aria-hidden="true"><span></span><span></span></div>
        </section>

        <section class="about section" id="about" aria-labelledby="about-title">
          <div class="section-heading">
            <h2 id="about-title">A little about me</h2>
          </div>
          <div class="section-copy">
            <p>I'm Nanasantoko, a developer who likes turning useful ideas into working software.</p>
            <p>My projects explore everyday organization, local file sharing, education, shopping, and university course planning. Each one starts with a real task and a clearer way to get it done.</p>
          </div>
        </section>

        <section class="work section" id="work" aria-labelledby="work-title">
          <div class="work-heading">
            <h2 id="work-title">Selected work</h2>
            <p>Five projects, each built around a different problem. Explore the source and details on GitHub.</p>
          </div>
          <div class="project-grid">
            {projects.map((project) => (
              <article class="project-card">
                <p class="project-category">{project.category}</p>
                <h3>{project.name}</h3>
                <p class="project-description">{project.description}</p>
                <div class="project-bottom">
                  <ul class="project-tags" aria-label={`${project.name} topics`}>
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                  <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.name} repository on GitHub`}>View repository <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="contact section" id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Let's connect.</h2>
          <p>Explore more of my work and follow what I'm building next.</p>
          <a class="button button-light" href={githubUrl} target="_blank" rel="noopener noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {year} Nanasantoko</span>
        <a href="#top">Back to top ↑</a>
      </footer>
    </div>
  </body>
</html>
