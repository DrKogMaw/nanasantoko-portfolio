---
import '../styles/global.css';

const githubUrl = 'https://github.com/DrKogMaw';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f0e6" />
    <meta name="description" content="Nana Santoko's developer portfolio. Explore work, background, and ways to connect." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nana Santoko — Developer</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label="Nana Santoko, back to top">N<span class="wordmark-dot">.</span>S</a>
        <nav aria-label="Main navigation">
          <a href="#about">About</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>

      <main id="top">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-content">
            <p class="intro">Hello, I'm Nana Santoko.</p>
            <h1 id="hero-title">I make things<br /><em>for the web.</em></h1>
            <p class="hero-description">A developer portfolio taking shape, one thoughtful project at a time.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↗</span></a>
              <a class="text-link" href={githubUrl} target="_blank" rel="noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-mark" aria-hidden="true"><span>N</span><span>S</span></div>
        </section>

        <section class="about section" id="about" aria-labelledby="about-title">
          <div class="section-heading">
            <h2 id="about-title">A little about me</h2>
          </div>
          <div class="section-copy">
            <p>I'm Nana, a developer building a home for my work on the web.</p>
            <p>This space is just getting started. As I add projects, you'll be able to see what I've made and how I approach each build.</p>
          </div>
        </section>

        <section class="work section" id="work" aria-labelledby="work-title">
          <div class="work-heading">
            <h2 id="work-title">Selected work</h2>
            <p>Good work deserves a proper introduction. Project stories are on the way.</p>
          </div>
          <div class="work-placeholder">
            <div class="placeholder-orbit" aria-hidden="true"><span></span></div>
            <p>Projects coming soon.</p>
            <a href={githubUrl} target="_blank" rel="noopener noreferrer">See my GitHub profile <span aria-hidden="true">↗</span></a>
          </div>
        </section>

        <section class="contact section" id="contact" aria-labelledby="contact-title">
          <h2 id="contact-title">Let's connect.</h2>
          <p>Have a look around my GitHub profile while this portfolio grows.</p>
          <a class="button button-light" href={githubUrl} target="_blank" rel="noopener noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a>
        </section>
      </main>

      <footer class="site-footer">
        <span>© {year} Nana Santoko</span>
        <a href="#top">Back to top ↑</a>
      </footer>
    </div>
  </body>
</html>
