---
import '../styles/global.css';

const githubUrl = 'https://github.com/DrKogMaw';
const year = new Date().getFullYear();
const stack = [['TS', 'TypeScript'], ['KT', 'Kotlin'], ['NG', 'Angular'], ['.N', 'ASP.NET Core'], ['JS', 'JavaScript'], ['AS', 'Astro']];
const filters = [['all', 'All (5)'], ['tools', 'Desktop & tools'], ['mobile', 'Mobile'], ['storefront', 'Storefront'], ['edtech', 'EdTech']];
const projects = [
  { name: 'DeskDrawer Inventory', category: 'Desktop app', filter: 'tools', description: 'A local inventory for the things in your desk drawers, with file attachments, photo previews, and portable JSON backups.', tags: ['TypeScript', 'Local storage'], url: 'https://github.com/DrKogMaw/desk-drawer-inventory', symbol: '▦' },
  { name: 'ZiAr', category: 'Windows + Android', filter: 'mobile', description: 'File transfers between a Windows PC and Android phone, or between two phones, over local Wi-Fi with a pairing code.', tags: ['Kotlin', 'Local network'], url: 'https://github.com/DrKogMaw/ZiAr', symbol: '↗' },
  { name: 'Ewear', category: 'Storefront', filter: 'storefront', description: 'A clothing storefront with category filters, a persistent shopping bag, phone-based sign-in, and tools for staff to manage products.', tags: ['Angular', 'ASP.NET Core'], url: 'https://github.com/DrKogMaw/ewear', symbol: '◈' },
  { name: 'EduSpark', category: 'Learning prototype', filter: 'edtech', description: 'A local-first reading, spelling, and vocabulary practice app for children ages 6–10, with English and Georgian modes.', tags: ['JavaScript', 'Education'], url: 'https://github.com/DrKogMaw/eduspark', symbol: '✳' },
  { name: 'Credit Compass Georgia', category: 'Static MVP', filter: 'tools', description: 'An estimator for how completed university courses may map to Georgian curricula. Results are estimates, not official credit decisions.', tags: ['Curriculum data', 'Planning'], url: 'https://github.com/DrKogMaw/credit-compass-georgia', symbol: '◎' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f9ff" />
    <meta name="description" content="Nanasantoko's developer portfolio. Explore desktop tools, learning apps, and web projects." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Nanasantoko — Developer</title>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'light'; } catch { document.documentElement.dataset.theme = 'light'; }</script>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div><div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header" id="top"><div class="nav-shell">
      <a class="brand" href="#top" aria-label="Nanasantoko, back to top"><span class="brand-mark" aria-hidden="true">✦</span>Nanasantoko<span class="brand-dot">.</span></a>
      <nav aria-label="Main navigation"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-sun" aria-hidden="true">☀</span><span class="theme-moon" aria-hidden="true">☾</span></button>
    </div></header>
    <main>
      <section class="hero section-width" aria-labelledby="hero-title">
        <div class="hero-copy"><p class="availability"><span class="status-dot"></span>Developer portfolio · 5 public projects</p><h1 id="hero-title">I make things <span>for the web.</span></h1><p class="hero-description">I'm Nanasantoko. I build practical tools and digital experiences, from desktop utilities to learning apps.</p><div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↗</span></a><a class="button button-quiet" href={githubUrl} target="_blank" rel="noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a></div><div class="hero-notes"><span>Desktop & mobile</span><span>Learning & web</span><span>Local-first projects</span></div></div>
        <div class="stack-panel"><div class="panel-heading"><div class="panel-icon" aria-hidden="true">⌘</div><div><h2>Core stack</h2><p>Technologies used across these projects</p></div></div><div class="stack-grid">{stack.map(([short, name]) => <div class="stack-item"><span class="stack-short" aria-hidden="true">{short}</span><span>{name}</span></div>)}</div><div class="terminal-line"><span aria-hidden="true">›</span><code>nanasantoko / projects</code><span class="terminal-count">5 found</span></div></div>
      </section>
      <section class="work section-width" id="work" aria-labelledby="work-title"><div class="section-intro"><div><h2 id="work-title">Selected work</h2><p>Five projects, each built around a different problem. Explore the source and details on GitHub.</p></div></div><div class="filters" role="group" aria-label="Filter projects">{filters.map(([value, label], index) => <button class:list={['filter-button', { active: index === 0 }]} type="button" data-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>)}</div><div class="project-grid">{projects.map((project, index) => <article class:list={['project-card', { featured: index === 0 }]} data-category={project.filter}><div class="card-top"><span class="card-icon" aria-hidden="true">{project.symbol}</span><span class="card-category">{project.category}</span></div><div class="card-body"><h3>{project.name}</h3><p>{project.description}</p></div><div class="card-footer"><ul class="project-tags" aria-label={`${project.name} technologies`}>{project.tags.map((tag) => <li>{tag}</li>)}</ul><a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.name} repository on GitHub`}>View repository <span aria-hidden="true">↗</span></a></div></article>)}</div></section>
      <section class="about section-width" id="about" aria-labelledby="about-title"><div class="about-panel"><div><h2 id="about-title">A little about me</h2><p class="about-lead">I'm Nanasantoko, a developer who likes turning useful ideas into working software.</p><p>My projects explore everyday organization, local file sharing, education, shopping, and university course planning. Each one starts with a real task and a clearer way to get it done.</p></div><div class="about-aside"><span class="aside-orbit" aria-hidden="true">✦</span><strong>Useful ideas.<br />Working software.</strong><span>Explore the projects to see the details.</span></div></div></section>
      <section class="contact section-width" id="contact" aria-labelledby="contact-title"><div class="contact-panel"><div class="contact-symbol" aria-hidden="true">✦</div><h2 id="contact-title">Let's connect.</h2><p>Explore more of my work and follow what I'm building next.</p><a class="button button-primary" href={githubUrl} target="_blank" rel="noopener noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a><span class="contact-handle">@DrKogMaw</span></div></section>
    </main>
    <footer class="site-footer section-width"><span>© {year} Nanasantoko</span><a href="#top">Back to top ↑</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      const syncTheme = () => { const dark = document.documentElement.dataset.theme === 'dark'; if (toggle) { toggle.setAttribute('aria-pressed', String(dark)); toggle.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`); } };
      syncTheme();
      toggle?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('portfolio-theme', next); } catch {} syncTheme(); });
      const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-button');
      const cards = document.querySelectorAll<HTMLElement>('.project-card');
      buttons.forEach((button) => button.addEventListener('click', () => { const selected = button.dataset.filter; buttons.forEach((item) => { const active = item === button; item.classList.toggle('active', active); item.setAttribute('aria-pressed', String(active)); }); cards.forEach((card) => { card.hidden = selected !== 'all' && card.dataset.category !== selected; }); }));
    </script>
  </body>
</html>
